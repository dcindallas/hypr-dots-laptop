#!/usr/bin/env python3
from pathlib import Path
import os
import re
import sys
import tempfile

source, target = map(Path, sys.argv[1:3])
colors = dict(re.findall(r"@define-color\s+([\w-]+)\s+([^;]+);", source.read_text()))

def color(name, seen=None):
    seen = set() if seen is None else seen
    if name in seen:
        raise ValueError("Circular color reference: " + name)
    seen.add(name)
    value = colors[name].strip()
    if value.startswith("@"):
        return color(value[1:], seen)
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise ValueError("Invalid color: " + name + " = " + value)
    return value

def blend(a, b, amount):
    return "#" + "".join(
        f"{round(int(a[i:i+2],16)*(1-amount)+int(b[i:i+2],16)*amount):02x}"
        for i in (1, 3, 5)
    )

bg, fg = color("window_bg_color"), color("window_fg_color")
accent = color("accent_bg_color" if "accent_bg_color" in colors else "accent_color")
values = {
    "background": bg, "foreground": fg, "cursorColor": accent,
    "dms_accent": accent, "dms_accent_text": color("accent_fg_color"),
    "dms_view": color("view_bg_color"), "dms_card": color("card_bg_color"),
    "dms_muted": blend(fg, bg, 0.35), "dms_border": blend(bg, fg, 0.20),
    "dms_hover": blend(bg, accent, 0.12),
}
# GTK provides semantic colors; ANSI slots use neutral/accent mappings.
values.update({f"color{i}": accent for i in range(16)})
values.update(color0=bg, color7=fg, color8=values["dms_muted"], color15=fg)

begin, end = "! BEGIN DMS COLORS", "! END DMS COLORS"
previous = target.read_text() if target.exists() else ""
previous = re.sub(
    re.escape(begin)+r".*?"+re.escape(end)+r"\n?",
    "", previous, flags=re.S
).rstrip()
block = "\n".join([
    begin, "! Generated from DMS GTK colors.",
    *(f"*{k}: {v}" for k, v in values.items()), end
])
content = (previous + "\n\n" if previous else "") + block + "\n"

fd, temporary = tempfile.mkstemp(dir=target.parent, prefix=".dms-xresources-")
try:
    with os.fdopen(fd, "w") as output:
        output.write(content)
    os.chmod(temporary, target.stat().st_mode & 0o777 if target.exists() else 0o644)
    os.replace(temporary, target)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
