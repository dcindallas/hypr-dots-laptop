#!/usr/bin/env bash
# ~/.local/bin/dms-sync
#
# Watch DankMaterialShell's generated GTK palette and refresh
# Cava, Xresources, Kitty, Kitty Dropdown, and GTK applications.

set -u

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

WATCH_DIR="$CONFIG_HOME/gtk-3.0"
WATCH_FILE="dank-colors.css"
WATCH_PATH="$WATCH_DIR/$WATCH_FILE"

CAVA_SYNC="$HOME/.local/bin/dms-sync-cava"
XRESOURCES="$HOME/.Xresources"

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/dms-sync-$UID.lock"

timestamp() {
    date '+%H:%M:%S'
}

log() {
    printf '[%s] %s\n' "$(timestamp)" "$*"
}

# Prevent multiple copies of this watcher from running.
exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    echo "DMS Architect is already running."
    exit 0
fi

if ! command -v inotifywait >/dev/null 2>&1; then
    echo "ERROR: inotifywait is not installed."
    echo "Install it with: yay -S inotify-tools"
    exit 1
fi

if [[ ! -d "$WATCH_DIR" ]]; then
    echo "ERROR: DMS GTK directory not found:"
    echo "  $WATCH_DIR"
    exit 1
fi

if [[ ! -f "$WATCH_PATH" ]]; then
    echo "ERROR: DMS color file not found:"
    echo "  $WATCH_PATH"
    exit 1
fi

sync_cava() {
    if [[ ! -x "$CAVA_SYNC" ]]; then
        log "Cava sync helper is missing or not executable: $CAVA_SYNC"
        return
    fi

    if "$CAVA_SYNC"; then
        log "Cava colors synced."
    else
        log "Cava color sync failed."
    fi
}

sync_xresources() {
    # Generate the palette, load it, and refresh Spotify.
    if ! python3 "$HOME/.local/bin/dms-sync-xresources" "$WATCH_PATH" "$XRESOURCES"; then
        log "Xresources generation failed."
        return 1
    fi
    if ! command -v xrdb >/dev/null 2>&1; then
        log "xrdb is missing; install xorg-xrdb."
        return 1
    fi
    if ! xrdb -merge "$XRESOURCES"; then
        log "Xresources loading failed."
        return 1
    fi
    log "Xresources generated and loaded."
    if command -v spicetify >/dev/null 2>&1; then
        if spicetify apply; then
            log "Spotify colors synced."
        else
            log "Spicetify apply failed."
        fi
    fi
}

reload_process() {
    local process="$1"
    local label="$2"

    if pgrep -x "$process" >/dev/null 2>&1; then
        if pkill -USR1 -x "$process" 2>/dev/null; then
            log "$label colors synced."
        else
            log "$label reload failed."
        fi
    fi
}

reload_gtk() {
    local current_theme

    if ! command -v gsettings >/dev/null 2>&1; then
        return
    fi

    current_theme="$(
        gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null |
            tr -d "'"
    )"

    if [[ -z "$current_theme" ]]; then
        log "Could not determine the current GTK theme."
        return
    fi

    if gsettings set org.gnome.desktop.interface gtk-theme "" &&
        gsettings set org.gnome.desktop.interface gtk-theme "$current_theme"; then
        log "GTK theme synced."
    else
        log "GTK theme reload failed."
    fi
}

sync_everything() {
    # Allow DMS/Matugen to finish writing its related theme files.
    sleep 0.25

    sync_cava
    sync_xresources

    reload_process "kitty" "Kitty"
    reload_process "kitty-dropdown" "Kitty Dropdown"

    # Geany does not support the same reliable signal reload.
    # Add a dedicated Geany theme bridge here later if required.

    reload_gtk
}

echo "DMS Architect: Monitoring $WATCH_PATH for palette updates..."

# Synchronize everything once when this watcher starts.
sync_everything

# Watch the directory rather than the file itself. This survives DMS replacing
# the CSS file atomically during wallpaper and theme changes.
inotifywait \
    -m \
    -q \
    -e close_write,moved_to \
    --format '%f' \
    "$WATCH_DIR" |
while IFS= read -r changed_file; do
    [[ "$changed_file" == "$WATCH_FILE" ]] || continue

    log "DMS palette changed."
    sync_everything
done
